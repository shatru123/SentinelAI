@page "/"
@attribute [Authorize]
@using SentinelAI.Contracts
@inject SentinelApiClient ApiClient

<PageTitle>Overview · SentinelAI</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Security operations / overview</p><h1>Good morning, operator.</h1><p class="muted">Your defensive posture at a glance.</p></div><AuthorizeView Roles="Admin,SecurityAnalyst"><Authorized><a class="primary-button" href="scans">+ New assessment</a></Authorized></AuthorizeView></div>
<div class="metric-grid">
    <div class="metric-card"><span>Assets discovered</span><strong>@AssetCount</strong><small>Phase 1 inventory</small></div>
    <div class="metric-card"><span>Online assets</span><strong>—</strong><small>Mock adapter only</small></div>
    <div class="metric-card"><span>Exposed services</span><strong>—</strong><small>Active probing disabled</small></div>
    <div class="metric-card"><span>Critical findings</span><strong>@FindingCount</strong><small>No findings yet</small></div>
</div>
<div class="content-grid">
    <section class="panel posture-panel"><div class="panel-heading"><div><p class="eyebrow">Security posture</p><h2>Baseline readiness</h2></div><span class="status-pill healthy">FOUNDATION</span></div><div class="posture-score"><span>Phase 1</span><strong>Authorization<br />controls</strong><div class="ring"><span>SAFE</span></div></div><p class="muted">Deterministic scope validation is authoritative. AI remains advisory and no active network probing is enabled.</p></section>
    <section class="panel activity-panel"><div class="panel-heading"><div><p class="eyebrow">Recent activity</p><h2>Audit stream</h2></div><a href="monitoring">View all</a></div>@if (Loading) { <p class="muted">Loading persisted activity…</p> } else if (!string.IsNullOrWhiteSpace(Error)) { <p class="error-text">@Error</p> } else { <div class="empty-state"><span class="empty-icon">⌁</span><strong>No activity yet</strong><p>Create an authorized scope to begin.</p></div> }</section>
</div>

@code {
    private int AssetCount;
    private int FindingCount;
    private bool Loading = true;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var assets = await ApiClient.GetPageAsync<AssetResponse>("/api/v1/assets", 1, 1);
            var findings = await ApiClient.GetPageAsync<FindingResponse>("/api/v1/findings", 1, 1);
            AssetCount = Math.Max(0, assets.TotalCount); FindingCount = Math.Max(0, findings.TotalCount);
        }
        catch (SentinelApiException exception) { Error = exception.UserMessage; }
        finally { Loading = false; }
    }
}
