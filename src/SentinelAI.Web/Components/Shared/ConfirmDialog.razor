@if (IsOpen)
{
    <div class="modal-backdrop is-open" @onclick="HandleCancel">
        <div class="soc-modal-card" @onclick:stopPropagation="true">
            <div class="soc-modal-header">
                <h3>@Title</h3>
                <button type="button" class="modal-close" @onclick="HandleCancel">✕</button>
            </div>
            <div class="soc-modal-body">
                <p>@Message</p>
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
            </div>
            <div class="soc-modal-footer">
                <button type="button" class="secondary-button" @onclick="HandleCancel">
                    @(CancelText ?? "Cancel")
                </button>
                <button type="button" class="@(IsDanger ? "danger-button" : "primary-button")" @onclick="HandleConfirm">
                    @(ConfirmText ?? "Confirm")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string? ConfirmText { get; set; }
    [Parameter] public string? CancelText { get; set; }
    [Parameter] public bool IsDanger { get; set; } = false;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleConfirm() => await OnConfirm.InvokeAsync();
    private async Task HandleCancel() => await OnCancel.InvokeAsync();
}
