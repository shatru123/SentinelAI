@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject SentinelApiClient ApiClient

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <header class="top-row">
            <div class="top-row-left">
                <div class="breadcrumb">
                    <span>SentinelAI</span>
                    <span>/</span>
                    <strong>@CurrentPageName</strong>
                </div>
            </div>

            <div class="top-row-right">
                <a href="/setup" class="ghost-button btn-sm" title="Open the dependency and worker readiness checks">
                    <span class="status-pill @GetHealthPillClass()">@systemHealthStatus</span> System Health
                </a>

                @if (!string.IsNullOrWhiteSpace(tenantId))
                {
                    <span class="status-pill pill-neutral" title="Current Tenant Context">
                        Tenant: @FormatId(tenantId)
                    </span>
                }

                <div class="status-pill @GetRolePillClass()" title="Authenticated User Role">
                    @userRole
                </div>

                <div class="user-profile-badge" title="Authenticated User Identity">
                    <span class="user-avatar">👤</span>
                    <span class="user-name">@userName</span>
                </div>

                <a href="/auth/logout" class="secondary-button btn-sm" title="Sign out of SentinelAI">
                    Sign Out ↗
                </a>
            </div>
        </header>

        <article class="content">
            @Body
        </article>

        <footer class="app-footer">
            <span class="app-footer-copy">SentinelAI Platform · Defensive security operations</span>
            <CreatorProfile />
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string userName = "Operator";
    private string userRole = "Viewer";
    private string tenantId = string.Empty;
    private string systemHealthStatus = "Checking";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.Identity.Name ?? "Operator";
            userRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Viewer";
            tenantId = user.FindFirst("tenant_id")?.Value ?? string.Empty;
        }

        try
        {
            var health = await ApiClient.GetJsonAsync<SystemHealthRecord>("/api/v1/monitoring/health");
            systemHealthStatus = health.Status;
        }
        catch (SentinelApiException)
        {
            systemHealthStatus = "Unavailable";
        }

        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }

    private string GetHealthPillClass() => systemHealthStatus.ToLowerInvariant() switch
    {
        "healthy" => "pill-healthy",
        "degraded" or "checking" => "pill-warning",
        _ => "pill-danger"
    };

    private sealed record SystemHealthRecord(string Status);

    private string CurrentPageName
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var segment = relative.Split('?', '#')[0].Trim('/');
            return segment switch
            {
                "" => "Overview",
                "assets" => "Asset Inventory",
                "scans" => "Security Scans",
                "web-assessments" => "Web Assessments",
                "findings" => "Vulnerabilities",
                "workers" or "agents" => "Worker Management",
                "monitoring" => "Monitoring & Audit",
                "setup" => "Setup & Health Checklist",
                "settings" => "Settings & Engine Configuration",
                _ => char.ToUpper(segment[0]) + segment[1..]
            };
        }
    }

    private string GetRolePillClass() => userRole.ToLowerInvariant() switch
    {
        "admin" => "pill-healthy",
        "securityanalyst" or "operator" => "pill-active",
        _ => "pill-neutral"
    };

    private static string FormatId(string id) => id.Length > 8 ? id[..8] + "…" : id;
}
