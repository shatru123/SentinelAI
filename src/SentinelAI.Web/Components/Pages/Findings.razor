@page "/findings"
@attribute [Authorize]
@using SentinelAI.Contracts
@inject SentinelApiClient ApiClient
<PageTitle>Vulnerabilities · SentinelAI</PageTitle>

<div class="page-heading"><div><p class="eyebrow">Risk / evidence-backed</p><h1>Vulnerabilities</h1><p class="muted">Findings become available when deterministic checks produce evidence.</p></div></div>
<section class="panel">
    <div class="panel-heading"><h2>Findings queue</h2><span class="status-pill healthy">NO ACTIVE SCANS</span></div>
    @if (loading)
    {
        <p class="muted">Loading persisted findings…</p>
    }
    else if (error is not null)
    {
        <div class="error-state"><p class="error-text">@error</p><button class="secondary-button" @onclick="RetryAsync">Retry</button></div>
    }
    else if (findings.Count == 0)
    {
        <div class="empty-state"><span class="empty-icon">◌</span><strong>No findings yet</strong><p>Phase 1 does not perform active probing or vulnerability exploitation.</p></div>
    }
    else
    {
        <table><thead><tr><th>Title</th><th>Severity</th><th>Asset</th><th>Created</th></tr></thead><tbody>
        @foreach (var finding in findings)
        {
            <tr><td>@DisplayTitle(finding)</td><td>@finding.Severity</td><td>@DisplayAsset(finding)</td><td>@DisplayTime(finding.CreatedAt)</td></tr>
        }
        </tbody></table>
    }
    <div class="pagination" aria-label="Finding pages">
        <button class="secondary-button" @onclick="PreviousPageAsync" disabled="@(loading || page <= 1)">Previous</button>
        <span class="muted">Page @this.page of @PageCount</span>
        <button class="secondary-button" @onclick="NextPageAsync" disabled="@(loading || !HasNextPage)">Next</button>
    </div>
</section>

@code {
    private const int PageSize = 25;
    private List<FindingResponse> findings = [];
    private int page = 1;
    private int totalCount;
    private bool loading = true;
    private string? error;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));
    private bool HasNextPage => page < PageCount;

    protected override async Task OnInitializedAsync() => await LoadPageAsync();

    private async Task LoadPageAsync()
    {
        loading = true;
        error = null;
        try
        {
            var result = await ApiClient.GetPageAsync<FindingResponse>("/api/v1/findings", page, PageSize);
            findings = result.Items?.ToList() ?? [];
            totalCount = Math.Max(0, result.TotalCount);
            page = Math.Max(1, result.Page);
        }
        catch (SentinelApiException exception) { findings = []; totalCount = 0; error = exception.UserMessage; }
        finally { loading = false; }
    }

    private Task RetryAsync() => LoadPageAsync();
    private async Task PreviousPageAsync() { if (page > 1) { page--; await LoadPageAsync(); } }
    private async Task NextPageAsync() { if (HasNextPage) { page++; await LoadPageAsync(); } }
    private static string DisplayTitle(FindingResponse finding) => string.IsNullOrWhiteSpace(finding.Title) ? "Untitled finding" : finding.Title;
    private static string DisplayAsset(FindingResponse finding) => finding.AssetId is Guid assetId ? assetId.ToString() : "Unlinked asset";
    private static string DisplayTime(DateTimeOffset value) => value == default ? "Not available" : value.ToLocalTime().ToString("g");
}
