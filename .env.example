# Copy to .env for local development. Never put real secrets in Git.
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=replace-with-local-dev-password
RABBITMQ_USER=sentinelai
RABBITMQ_PASSWORD=replace-with-local-dev-password
WORKER_CONTROL_PLANE_TOKEN=replace-with-worker-token
WORKER_IDENTITY=compose-worker
# Local Compose dashboard uses distinct development identities for requester and approver.
DASHBOARD_ROLE=Admin
DASHBOARD_APPROVER_USER_ID=00000000-0000-0000-0000-000000000003
WORKER_TENANT_ID=00000000-0000-0000-0000-000000000001
AI_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
