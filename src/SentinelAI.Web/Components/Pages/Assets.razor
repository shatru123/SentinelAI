@page "/assets"
@attribute [Authorize]
@using SentinelAI.Contracts
@inject SentinelApiClient ApiClient
<PageTitle>Assets · SentinelAI</PageTitle>

<div class="page-heading"><div><p class="eyebrow">Inventory / authorized scope</p><h1>Assets</h1><p class="muted">Persisted passive observations from authorized scopes.</p></div></div>
<section class="panel">
    <div class="panel-heading"><h2>Asset inventory</h2><span class="status-pill healthy">PASSIVE ONLY</span></div>
    @if (loading)
    {
        <p class="muted">Loading persisted assets…</p>
    }
    else if (error is not null)
    {
        <div class="error-state"><p class="error-text">@error</p><button class="secondary-button" @onclick="RetryAsync">Retry</button></div>
    }
    else if (assets.Count == 0)
    {
        <div class="empty-state"><span class="empty-icon">⌁</span><strong>No assets discovered</strong><p>Register an authorized scope and submit a mock assessment.</p></div>
    }
    else
    {
        <table><thead><tr><th>Address</th><th>Type</th><th>Status</th><th>Last observed</th><th>Last reachable</th></tr></thead><tbody>
        @foreach (var asset in assets)
        {
            <tr><td>@DisplayAddress(asset)</td><td>@asset.Kind</td><td>@(asset.IsOnline ? "Online" : "Not confirmed")</td><td>@DisplayTime(asset.LastObservedAt)</td><td>@DisplayTime(asset.LastSuccessfulReachabilityAt)</td></tr>
        }
        </tbody></table>
    }
    <div class="pagination" aria-label="Asset pages">
        <button class="secondary-button" @onclick="PreviousPageAsync" disabled="@(loading || page <= 1)">Previous</button>
        <span class="muted">Page @this.page of @PageCount</span>
        <button class="secondary-button" @onclick="NextPageAsync" disabled="@(loading || !HasNextPage)">Next</button>
    </div>
</section>

@code {
    private const int PageSize = 25;
    private List<AssetResponse> assets = [];
    private int page = 1;
    private int totalCount;
    private bool loading = true;
    private string? error;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));
    private bool HasNextPage => page < PageCount;

    protected override async Task OnInitializedAsync() => await LoadPageAsync();

    private async Task LoadPageAsync()
    {
        loading = true;
        error = null;
        try
        {
            var result = await ApiClient.GetPageAsync<AssetResponse>("/api/v1/assets", page, PageSize);
            assets = result.Items?.ToList() ?? [];
            totalCount = Math.Max(0, result.TotalCount);
            page = Math.Max(1, result.Page);
        }
        catch (SentinelApiException exception) { assets = []; totalCount = 0; error = exception.UserMessage; }
        finally { loading = false; }
    }

    private Task RetryAsync() => LoadPageAsync();
    private async Task PreviousPageAsync() { if (page > 1) { page--; await LoadPageAsync(); } }
    private async Task NextPageAsync() { if (HasNextPage) { page++; await LoadPageAsync(); } }
    private static string DisplayAddress(AssetResponse asset) => string.IsNullOrWhiteSpace(asset.Address) ? "Address unavailable" : asset.Address;
    private static string DisplayTime(DateTimeOffset? value) => value is null || value == default ? "Not available" : value.Value.ToLocalTime().ToString("g");
}
