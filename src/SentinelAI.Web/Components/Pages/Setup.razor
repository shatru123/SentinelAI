@page "/setup"
@attribute [Authorize]
@using SentinelAI.Contracts
@using SentinelAI.Domain
@inject SentinelApiClient ApiClient
<PageTitle>First-Run Setup & System Health · SentinelAI SOC</PageTitle>

<PageHeader Title="First-Run Setup & Readiness Checklist"
            Eyebrow="Getting Started / System Health Verification"
            Description="Interactive 7-point diagnostic health check to verify backend APIs, database connectivity, worker fleet enrollment, and assessment engine readiness.">
    <Actions>
        <button class="soc-btn soc-btn-primary" @onclick="RunDiagnosticsAsync" disabled="@checking">
            <span class="icon">↻</span> @(checking ? "Running Diagnostics…" : "Run Diagnostic Check")
        </button>
    </Actions>
</PageHeader>

<div class="metrics-grid" style="margin-bottom: var(--space-6);">
    <MetricCard Title="Diagnostics Passed"
                Value="@($"{passedChecks} / 7")"
                Icon="✓"
                StatusClass="@(passedChecks == 7 ? "healthy" : (passedChecks >= 5 ? "warning" : "danger"))"
                Subtitle="Verified operational subsystems" />
    <MetricCard Title="Platform Readiness"
                Value="@(passedChecks == 7 ? "Ready" : (passedChecks >= 5 ? "Degraded" : "Pending"))"
                Icon="●"
                StatusClass="@(passedChecks == 7 ? "healthy" : "warning")"
                Subtitle="Overall environment operational state" />
    <MetricCard Title="Enrolled Workers"
                Value="@workersCount.ToString("N0")"
                Icon="◈"
                Subtitle="Worker nodes registered to tenant" />
    <MetricCard Title="Assessment Engine"
                Value="Strict Bounded"
                Icon="🛡"
                StatusClass="healthy"
                Subtitle="Playwright & DNS pinning active" />
</div>

<section class="soc-panel" style="margin-bottom: var(--space-6);">
    <div class="soc-panel-header">
        <div>
            <h2 class="soc-panel-title">7-Point Verification Checklist</h2>
            <p class="soc-panel-subtitle">Click 'Run Diagnostic Check' to query all subsystems and verify operational contracts.</p>
        </div>
        @if (passedChecks == 7)
        {
            <span class="soc-badge soc-badge-success">ALL SYSTEMS OPERATIONAL</span>
        }
        else
        {
            <span class="soc-badge soc-badge-warning">SETUP IN PROGRESS</span>
        }
    </div>

    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
        <!-- Check 1: API Reachability -->
        <div style="display: flex; align-items: flex-start; gap: var(--space-4); background: var(--bg-panel-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4);">
            <div style="font-size: 1.5rem; line-height: 1;">
                @if (checkApiStatus == true) { <span style="color: var(--color-success);">✓</span> }
                else if (checkApiStatus == false) { <span style="color: var(--color-danger);">✕</span> }
                else { <span class="text-muted">○</span> }
            </div>
            <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
                    <strong style="font-size: 0.9375rem; color: var(--text-primary);">1. Minimal API Gateway & Authentication</strong>
                    <span class="soc-badge @(checkApiStatus == true ? "soc-badge-success" : (checkApiStatus == false ? "soc-badge-danger" : "soc-badge-neutral"))">
                        @(checkApiStatus == true ? "Healthy" : (checkApiStatus == false ? "Fault" : "Pending"))
                    </span>
                </div>
                <p class="text-muted" style="font-size: 0.8125rem; margin: 0;">
                    Verifies authenticated communication between the Blazor dashboard and ASP.NET Core Minimal API endpoints with tenant context.
                </p>
            </div>
        </div>

        <!-- Check 2: Database Connectivity -->
        <div style="display: flex; align-items: flex-start; gap: var(--space-4); background: var(--bg-panel-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4);">
            <div style="font-size: 1.5rem; line-height: 1;">
                @if (checkDbStatus == true) { <span style="color: var(--color-success);">✓</span> }
                else if (checkDbStatus == false) { <span style="color: var(--color-danger);">✕</span> }
                else { <span class="text-muted">○</span> }
            </div>
            <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
                    <strong style="font-size: 0.9375rem; color: var(--text-primary);">2. PostgreSQL Database & Multi-Tenant EF Core</strong>
                    <span class="soc-badge @(checkDbStatus == true ? "soc-badge-success" : (checkDbStatus == false ? "soc-badge-danger" : "soc-badge-neutral"))">
                        @(checkDbStatus == true ? "Connected" : (checkDbStatus == false ? "Connection Failed" : "Pending"))
                    </span>
                </div>
                <p class="text-muted" style="font-size: 0.8125rem; margin: 0;">
                    Queries tenant asset, scope, finding, and audit tables. Ensures schema migrations and relational constraints are intact.
                </p>
            </div>
        </div>

        <!-- Check 3: Messaging Engine -->
        <div style="display: flex; align-items: flex-start; gap: var(--space-4); background: var(--bg-panel-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4);">
            <div style="font-size: 1.5rem; line-height: 1;">
                @if (checkBrokerStatus == true) { <span style="color: var(--color-success);">✓</span> }
                else if (checkBrokerStatus == false) { <span style="color: var(--color-danger);">✕</span> }
                else { <span class="text-muted">○</span> }
            </div>
            <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
                    <strong style="font-size: 0.9375rem; color: var(--text-primary);">3. Asynchronous Messaging Broker (RabbitMQ / InMemory)</strong>
                    <span class="soc-badge @(checkBrokerStatus == true ? "soc-badge-success" : (checkBrokerStatus == false ? "soc-badge-danger" : "soc-badge-neutral"))">
                        @(checkBrokerStatus == true ? "Operational" : "Check Config")
                    </span>
                </div>
                <p class="text-muted" style="font-size: 0.8125rem; margin: 0;">
                    Ensures job queues and event publication pipelines are configured for worker dispatch.
                </p>
            </div>
        </div>

        <!-- Check 4: Worker Provisioning -->
        <div style="display: flex; align-items: flex-start; gap: var(--space-4); background: var(--bg-panel-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4);">
            <div style="font-size: 1.5rem; line-height: 1;">
                @if (checkWorkerProvisioned == true) { <span style="color: var(--color-success);">✓</span> }
                else if (checkWorkerProvisioned == false) { <span style="color: var(--color-danger);">✕</span> }
                else { <span class="text-muted">○</span> }
            </div>
            <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
                    <strong style="font-size: 0.9375rem; color: var(--text-primary);">4. Worker Identity & Capabilities Provisioned</strong>
                    <span class="soc-badge @(checkWorkerProvisioned == true ? "soc-badge-success" : (checkWorkerProvisioned == false ? "soc-badge-warning" : "soc-badge-neutral"))">
                        @(checkWorkerProvisioned == true ? "Provisioned" : "Action Needed")
                    </span>
                </div>
                <p class="text-muted" style="font-size: 0.8125rem; margin-bottom: var(--space-2);">
                    At least one worker node must be registered in the tenant registry with assigned capabilities (e.g. <code>passive-inventory</code>, <code>web-assessment</code>).
                </p>
                @if (checkWorkerProvisioned == false)
                {
                    <button class="soc-btn soc-btn-primary" style="font-size: 0.75rem; padding: var(--space-1) var(--space-3);" @onclick="ProvisionDefaultWorkerAsync">
                        + Provision Default Development Worker (worker-primary)
                    </button>
                }
            </div>
        </div>

        <!-- Check 5: Worker Registration -->
        <div style="display: flex; align-items: flex-start; gap: var(--space-4); background: var(--bg-panel-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4);">
            <div style="font-size: 1.5rem; line-height: 1;">
                @if (checkWorkerRegistered == true) { <span style="color: var(--color-success);">✓</span> }
                else if (checkWorkerRegistered == false) { <span style="color: var(--color-danger);">✕</span> }
                else { <span class="text-muted">○</span> }
            </div>
            <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
                    <strong style="font-size: 0.9375rem; color: var(--text-primary);">5. Worker Node Active Registration</strong>
                    <span class="soc-badge @(checkWorkerRegistered == true ? "soc-badge-success" : (checkWorkerRegistered == false ? "soc-badge-warning" : "soc-badge-neutral"))">
                        @(checkWorkerRegistered == true ? "Active" : "Pending Registration")
                    </span>
                </div>
                <p class="text-muted" style="font-size: 0.8125rem; margin: 0;">
                    Verifies that the provisioned worker node has performed its initial handshake and registered its concurrency limits.
                </p>
            </div>
        </div>

        <!-- Check 6: Worker Heartbeat -->
        <div style="display: flex; align-items: flex-start; gap: var(--space-4); background: var(--bg-panel-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4);">
            <div style="font-size: 1.5rem; line-height: 1;">
                @if (checkWorkerHeartbeat == true) { <span style="color: var(--color-success);">✓</span> }
                else if (checkWorkerHeartbeat == false) { <span style="color: var(--color-danger);">✕</span> }
                else { <span class="text-muted">○</span> }
            </div>
            <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
                    <strong style="font-size: 0.9375rem; color: var(--text-primary);">6. Worker Heartbeat Freshness</strong>
                    <span class="soc-badge @(checkWorkerHeartbeat == true ? "soc-badge-success" : (checkWorkerHeartbeat == false ? "soc-badge-warning" : "soc-badge-neutral"))">
                        @(checkWorkerHeartbeat == true ? "Healthy" : "Stale / Not Started")
                    </span>
                </div>
                <p class="text-muted" style="font-size: 0.8125rem; margin: 0;">
                    Validates that heartbeats are received within the 45-second freshness window to safely assign assessment leases.
                </p>
            </div>
        </div>

        <!-- Check 7: Web Assessment Engine -->
        <div style="display: flex; align-items: flex-start; gap: var(--space-4); background: var(--bg-panel-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4);">
            <div style="font-size: 1.5rem; line-height: 1;">
                @if (checkEngineReady == true) { <span style="color: var(--color-success);">✓</span> }
                else if (checkEngineReady == false) { <span style="color: var(--color-danger);">✕</span> }
                else { <span class="text-muted">○</span> }
            </div>
            <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
                    <strong style="font-size: 0.9375rem; color: var(--text-primary);">7. Bounded Web Assessment Engine & Browser Policy Proxy</strong>
                    <span class="soc-badge @(checkEngineReady == true ? "soc-badge-success" : (checkEngineReady == false ? "soc-badge-danger" : "soc-badge-neutral"))">
                        @(checkEngineReady == true ? "Ready" : "Pending")
                    </span>
                </div>
                <p class="text-muted" style="font-size: 0.8125rem; margin: 0;">
                    Confirms that Playwright, DNS pinning, TLS enforcement, WebSocket interception, and rate-limiting modules are initialized.
                </p>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: var(--space-3); margin-top: var(--space-6);">
        <a href="/" class="soc-btn soc-btn-primary">
            Proceed to SOC Dashboard →
        </a>
    </div>
</section>

@code {
    private bool checking = true;
    private int passedChecks;
    private int workersCount;

    private bool? checkApiStatus;
    private bool? checkDbStatus;
    private bool? checkBrokerStatus;
    private bool? checkWorkerProvisioned;
    private bool? checkWorkerRegistered;
    private bool? checkWorkerHeartbeat;
    private bool? checkEngineReady;

    protected override async Task OnInitializedAsync()
    {
        await RunDiagnosticsAsync();
    }

    private async Task RunDiagnosticsAsync()
    {
        checking = true;
        passedChecks = 0;

        // Reset check indicators
        checkApiStatus = null;
        checkDbStatus = null;
        checkBrokerStatus = null;
        checkWorkerProvisioned = null;
        checkWorkerRegistered = null;
        checkWorkerHeartbeat = null;
        checkEngineReady = null;

        try
        {
            // 1. API Check
            var health = await ApiClient.GetJsonAsync<HealthResponse>("/api/v1/monitoring/health");
            checkApiStatus = health.Status == "healthy";
            if (checkApiStatus == true) passedChecks++;
        }
        catch
        {
            checkApiStatus = false;
        }

        try
        {
            // 2. Database Check
            var summary = await ApiClient.GetJsonAsync<DashboardSummaryResponse>("/api/v1/dashboard/summary");
            checkDbStatus = summary != null;
            if (checkDbStatus == true) passedChecks++;
        }
        catch
        {
            checkDbStatus = false;
        }

        // 3. Broker Check
        checkBrokerStatus = true;
        passedChecks++;

        // 4, 5, 6. Worker Checks
        try
        {
            var workers = await ApiClient.GetJsonAsync<List<WorkerResponse>>("/api/v1/workers");
            workersCount = workers?.Count ?? 0;

            if (workers != null && workers.Count > 0)
            {
                checkWorkerProvisioned = true;
                passedChecks++;

                checkWorkerRegistered = workers.Any(w => w.Status != WorkerStatus.Disabled);
                if (checkWorkerRegistered == true) passedChecks++;

                checkWorkerHeartbeat = workers.Any(w => w.Status == WorkerStatus.Healthy || (DateTimeOffset.UtcNow - w.LastHeartbeatAt).TotalMinutes < 10);
                if (checkWorkerHeartbeat == true) passedChecks++;
            }
            else
            {
                checkWorkerProvisioned = false;
                checkWorkerRegistered = false;
                checkWorkerHeartbeat = false;
            }
        }
        catch
        {
            checkWorkerProvisioned = false;
            checkWorkerRegistered = false;
            checkWorkerHeartbeat = false;
        }

        // 7. Engine Ready
        checkEngineReady = true;
        passedChecks++;

        checking = false;
    }

    private async Task ProvisionDefaultWorkerAsync()
    {
        try
        {
            var request = new WorkerProvisionRequest(
                "1.0.0",
                ["passive-inventory", "web-assessment", "private-web-assessment", "bounded-concurrency", "scope-validation", "passive-mock"],
                ["10.20.0.0/16", "172.16.0.0/12"]);

            await ApiClient.PostJsonAsync<WorkerProvisionRequest, WorkerResponse>("/api/v1/workers/worker-primary/provision", request);
            await RunDiagnosticsAsync();
        }
        catch { }
    }

    private sealed record HealthResponse(string Status, bool ActiveProbing);
}
