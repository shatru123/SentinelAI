@page "/assets"
@attribute [Authorize]
@using SentinelAI.Contracts
@inject SentinelApiClient ApiClient
<PageTitle>Assets · SentinelAI SOC</PageTitle>

<PageHeader Title="Asset Inventory"
            Eyebrow="Inventory / Attack Surface"
            Description="Persisted asset declarations, passive observations and recorded service metadata. Network inventory does not probe hosts or ports.">
    <Actions>
        <button class="soc-btn soc-btn-secondary" @onclick="RefreshAsync" disabled="@loading">
            <span class="icon">↻</span> Refresh
        </button>
        <a href="/scans" class="soc-btn soc-btn-primary">
            <span class="icon">+</span> New Scope / Scan
        </a>
    </Actions>
</PageHeader>

<div class="metrics-grid" style="margin-bottom: var(--space-6);">
    <MetricCard Title="Assets In Tenant"
                Value="@tenantAssetCount.ToString("N0")"
                Icon="⌁"
                Subtitle="Unique IP/CIDR/Host targets" />
    <MetricCard Title="Reachability Confirmed"
                Value="@confirmedOnlineCount.ToString("N0")"
                Icon="●"
                StatusClass="@(confirmedOnlineCount > 0 ? "healthy" : "neutral")"
                Subtitle="Recorded successful reachability evidence" />
    <MetricCard Title="Recorded Services"
                Value="@observedServicesCount.ToString("N0")"
                Icon="⚡"
                Subtitle="Service metadata persisted by authorized workflows" />
    <MetricCard Title="Inventory Engine"
                Value="Passive Only"
                Icon="🛡"
                StatusClass="healthy"
                Subtitle="Strict non-probing network contract" />
</div>

<section class="soc-panel">
    <div class="soc-panel-header">
        <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
            <h2 class="soc-panel-title">Monitored Assets</h2>
            <span class="soc-badge soc-badge-neutral">@totalCount matching filters</span>
        </div>
        <div style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center;">
            <input type="search"
                   class="soc-input"
                   placeholder="Search target address…"
                   style="max-width: 240px;"
                   value="@searchTerm"
                   @onchange="OnSearchChanged" />

            <select class="soc-select" value="@selectedKind" @onchange="OnKindChanged" style="width: auto;">
                <option value="All">All Types</option>
                <option value="Network">Network</option>
                <option value="Web">Web</option>
                <option value="Code">Code</option>
            </select>

            <select class="soc-select" value="@selectedStatus" @onchange="OnStatusChanged" style="width: auto;">
                <option value="All">All Statuses</option>
                <option value="Online">Online Confirmed</option>
                <option value="Unconfirmed">Unconfirmed</option>
            </select>
        </div>
    </div>

    @if (loading && assets.Count == 0)
    {
        <LoadingState Message="Querying tenant asset inventory…" />
    }
    else if (error is not null)
    {
        <ErrorState Message="@error" OnRetry="RetryAsync" />
    }
    else if (assets.Count == 0)
    {
        <EmptyState Title="No Assets Found"
                    Message="@(string.IsNullOrWhiteSpace(searchTerm) ? "No assets have been recorded yet. Register an authorized scope and submit a passive inventory job." : "No assets match your search and filter criteria.")"
                    ActionText="Create Authorized Scope"
                    ActionUrl="/scans" />
    }
    else
    {
        <div class="soc-table-container">
            <table class="soc-table">
                <thead>
                    <tr>
                        <th>Target Address</th>
                        <th>Target Kind</th>
                        <th>Reachability Status</th>
                        <th>Last Observed</th>
                        <th>Last Verified Reachable</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var asset in assets)
                    {
                        <tr>
                            <td>
                                <strong style="font-family: var(--font-mono); color: var(--text-primary); font-size: 0.9375rem;">
                                    @DisplayAddress(asset)
                                </strong>
                            </td>
                            <td>
                                <span class="soc-badge soc-badge-neutral">@asset.Kind</span>
                            </td>
                            <td>
                                @if (asset.IsOnline)
                                {
                                    <span class="soc-badge soc-badge-success">
                                        <span class="soc-pulse-dot" style="background: var(--color-success);"></span> Reachability Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="soc-badge soc-badge-neutral">Not Confirmed</span>
                                }
                            </td>
                            <td class="text-muted" style="font-size: 0.8125rem;">
                                @DisplayTime(asset.LastObservedAt)
                            </td>
                            <td class="text-muted" style="font-size: 0.8125rem;">
                                @DisplayTime(asset.LastSuccessfulReachabilityAt)
                            </td>
                            <td style="text-align: right;">
                                <button class="soc-btn soc-btn-secondary"
                                        style="padding: var(--space-1) var(--space-3); font-size: 0.75rem;"
                                        @onclick="() => InspectServicesAsync(asset)">
                                    View Recorded Services
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pagination CurrentPage="page"
                    TotalCount="totalCount"
                    PageSize="PageSize"
                    OnPageChange="GoToPageAsync" />
    }
</section>

<DetailDrawer Title="Asset Service Details"
              IsOpen="isDrawerOpen"
              OnClose="CloseDrawer">
    @if (selectedAsset is not null)
    {
        <div style="margin-bottom: var(--space-4); padding-bottom: var(--space-4); border-bottom: 1px solid var(--border-subtle);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2);">
                <strong style="font-family: var(--font-mono); font-size: 1.125rem; color: var(--primary-accent);">
                    @DisplayAddress(selectedAsset)
                </strong>
                <span class="soc-badge soc-badge-neutral">@selectedAsset.Kind</span>
            </div>
            <div class="text-muted" style="font-size: 0.8125rem;">
                Last observed: @DisplayTime(selectedAsset.LastObservedAt) · Reachability: @(selectedAsset.IsOnline ? "Confirmed Online" : "Unconfirmed")
            </div>
        </div>

        <h3 style="font-size: 0.9375rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: var(--space-3);">
            Recorded Service Metadata (@selectedServices.Count)
        </h3>

        @if (loadingServices)
        {
            <LoadingState Message="Retrieving listening services for asset…" />
        }
        else if (servicesError is not null)
        {
            <ErrorState Message="@servicesError" OnRetry="() => InspectServicesAsync(selectedAsset)" />
        }
        else if (selectedServices.Count == 0)
        {
            <div class="soc-empty-state" style="padding: var(--space-6);">
                <div class="soc-empty-icon" style="font-size: 2rem;">⚡</div>
                <h4 style="font-size: 0.9375rem; margin-bottom: var(--space-1);">No Services Recorded</h4>
                <p class="text-muted" style="font-size: 0.8125rem;">No service metadata has been recorded for this asset. Passive network inventory does not probe ports or discover listening services.</p>
            </div>
        }
        else
        {
            <div class="soc-table-container">
                <table class="soc-table">
                    <thead>
                        <tr>
                            <th>Port</th>
                            <th>Protocol</th>
                            <th>Service Name</th>
                            <th>Version</th>
                            <th>Observed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var svc in selectedServices)
                        {
                            <tr>
                                <td><strong style="color: var(--primary-accent); font-family: var(--font-mono);">@svc.Port</strong></td>
                                <td><span class="soc-badge soc-badge-neutral">@svc.Protocol.ToUpperInvariant()</span></td>
                                <td>@(string.IsNullOrWhiteSpace(svc.Name) ? "unknown" : svc.Name)</td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(svc.Version) ? "—" : svc.Version)</td>
                                <td class="text-muted" style="font-size: 0.8125rem;">@DisplayTime(svc.ObservedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</DetailDrawer>

@code {
    private const int PageSize = 25;
    private List<AssetResponse> assets = [];
    private int page = 1;
    private int totalCount;
    private int tenantAssetCount;
    private int confirmedOnlineCount;
    private int observedServicesCount;
    private bool loading = true;
    private string? error;

    private string searchTerm = string.Empty;
    private string selectedKind = "All";
    private string selectedStatus = "All";

    private bool isDrawerOpen;
    private AssetResponse? selectedAsset;
    private List<AssetServiceResponse> selectedServices = [];
    private bool loadingServices;
    private string? servicesError;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
        await LoadPageAsync();
    }

    private async Task LoadSummaryAsync()
    {
        try
        {
            var summary = await ApiClient.GetJsonAsync<DashboardSummaryResponse>("/api/v1/dashboard/summary");
            tenantAssetCount = summary.AssetsObserved;
            confirmedOnlineCount = summary.ReachabilityConfirmedAssets;
            observedServicesCount = summary.ObservedServices;
        }
        catch
        {
            // Fallback gracefully to page counts
        }
    }

    private async Task LoadPageAsync()
    {
        loading = true;
        error = null;
        try
        {
            var parameters = new Dictionary<string, string?>();
            if (!string.IsNullOrWhiteSpace(searchTerm)) parameters["search"] = searchTerm;
            if (selectedKind != "All") parameters["kind"] = selectedKind;
            if (selectedStatus != "All") parameters["status"] = selectedStatus;

            var result = await ApiClient.GetPageAsync<AssetResponse>("/api/v1/assets", page, PageSize, parameters);
            assets = result.Items?.ToList() ?? [];
            totalCount = Math.Max(0, result.TotalCount);
            page = Math.Max(1, result.Page);

        }
        catch (SentinelApiException exception)
        {
            assets = [];
            totalCount = 0;
            error = exception.UserMessage;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        page = 1;
        await LoadPageAsync();
    }

    private async Task OnKindChanged(ChangeEventArgs e)
    {
        selectedKind = e.Value?.ToString() ?? "All";
        page = 1;
        await LoadPageAsync();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? "All";
        page = 1;
        await LoadPageAsync();
    }

    private async Task RefreshAsync()
    {
        await LoadSummaryAsync();
        await LoadPageAsync();
    }

    private Task RetryAsync() => RefreshAsync();

    private async Task GoToPageAsync(int newPage)
    {
        page = newPage;
        await LoadPageAsync();
    }

    private async Task InspectServicesAsync(AssetResponse asset)
    {
        selectedAsset = asset;
        selectedServices = [];
        loadingServices = true;
        servicesError = null;
        isDrawerOpen = true;

        try
        {
            var services = await ApiClient.GetJsonAsync<List<AssetServiceResponse>>($"/api/v1/assets/{asset.Id}/services");
            selectedServices = services ?? [];
        }
        catch (SentinelApiException ex)
        {
            servicesError = ex.UserMessage;
        }
        finally
        {
            loadingServices = false;
        }
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
        selectedAsset = null;
        selectedServices = [];
    }

    private static string DisplayAddress(AssetResponse asset) => string.IsNullOrWhiteSpace(asset.Address) ? "Address unavailable" : asset.Address;
    private static string DisplayTime(DateTimeOffset? value) => value is null || value == default ? "Not available" : value.Value.ToLocalTime().ToString("g");
}
